# Database (local MySQL — see docs/LOCAL_DATABASE_SETUP.md)
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/dizlee_dev"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# File storage (optional for local dev)
BLOB_READ_WRITE_TOKEN=""

# SMTP (required in production for invite / forgot-password emails)
# Hostinger Titan: SMTP_HOST=smtp.titan.email, SMTP_PORT=465
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Optional: reroute all outgoing mail to one inbox for testing (remove in production)
SMTP_REDIRECT_TO=""

# UC-07 automatic submission reminders cron endpoint
CRON_SECRET=""
# Optional fallback actor when admin@dizlee.com is not seeded
SYSTEM_USER_ID=""
