# Database (local MySQL — see docs/LOCAL_DATABASE_SETUP.md)
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/dizlee_dev"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# File storage — Vercel Blob (required on Vercel; optional locally)
# Without this, uploads use local `.uploads/` (works only on your machine).
# On Vercel: create a Private Blob store and connect it to the project.
BLOB_READ_WRITE_TOKEN=""
# BLOB_STORE_ID=""  # usually auto-set when the store is connected on Vercel

# SMTP credentials (required for invite / forgot-password / test emails)
# Host / port / from can also be set in Admin → Email Settings (DB).
# Credentials must stay in .env: SMTP_USER, SMTP_PASSWORD
# Hostinger Titan: SMTP_HOST=smtp.titan.email, SMTP_PORT=465
EMAIL_ENABLED="true"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Optional: reroute all outgoing mail to one inbox for local/testing ONLY.
# Ignored automatically when NODE_ENV=production (do not rely on this in prod).
SMTP_REDIRECT_TO=""

# UC-07 automatic submission reminders cron endpoint
# On Vercel, set the same value; Cron Jobs send Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
# Optional fallback actor when admin@dizlee.com is not seeded
SYSTEM_USER_ID=""

# Production / TiDB (see docs/CD_VERCEL_TIDB.md)
# DATABASE_URL="mysql://USER:PASS@HOST:4000/dizlee_staging?sslaccept=strict"
# NEXTAUTH_URL="https://your-app.vercel.app"
